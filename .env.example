# Copy to .env and fill in. Never commit .env.

# --- Branding (can be changed any time) ---
APP_NAME=Amma's Recipe Book

# --- Sign-in ---
# Generate with:  npm run hash-passphrase -- "your family passphrase"
# Left empty in development, the temporary passphrase is "amma". Required in production.
FAMILY_PASSPHRASE_HASH=

# --- Where data lives (SQLite file + audio). On a host, point this at the persistent volume, e.g. /data ---
DATA_DIR=./data

# --- Speech-to-text: mock | openai | sarvam ---
# "mock" is a development simulation and is refused in production.
STT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
SARVAM_API_KEY=

# --- Recipe writing: mock | anthropic ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Server ---
PORT=8787
# NODE_ENV=production   (set on the host; turns on Secure cookies and refuses mock adapters)
